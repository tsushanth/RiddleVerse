# Backend Environment Variables
# Copy this file to .env and fill in the values

# ===================
# Database
# ===================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ===================
# Firebase
# ===================
# JSON string of your Firebase service account key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ===================
# Google Cloud Storage
# ===================
# JSON string of your GCS service account key
GCS_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ===================
# AI API Keys
# ===================
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
PIXABAY_API_KEY=your-pixabay-key

# ===================
# Email
# ===================
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ===================
# Cloud Scheduler
# ===================
SCHEDULER_SECRET=your-scheduler-secret

# ===================
# Redis
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# Stripe (Creator Payouts)
# ===================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===================
# Server
# ===================
PORT=3001
NODE_ENV=development
