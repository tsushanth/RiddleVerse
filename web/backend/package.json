    "axios": "^1.11.0",
    "canvas": "^3.2.0",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "cosine-similarity": "^1.0.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
