{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "copy-frontend": "mkdir -p public && cp -r ../frontend/* public/",
    "start": "npm run copy-frontend && node server.js",
    "dev": "npm run copy-frontend && nodemon server.js",
    "health-check": "node scripts/health-check.js",
    "health-check:quick": "curl -f http://localhost:8080/api/health",
    "health-check:detailed": "curl -s http://localhost:8080/api/health/detailed | jq",
    "startup-check": "npm run health-check",
    "docker-health": "curl -f http://localhost:8080/api/health || exit 1"
  },
